<Window x:Class="OfflineStore.FinanceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OfflineStore"
 Title="الحسابات والخزنة" Width="1100" Height="750" MinWidth="800" MinHeight="600" FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner" Background="{DynamicResource BaseBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources><local:FinanceMoneyConverter x:Key="Money"/></Window.Resources>
 <DockPanel Margin="14">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="السياسة الحالية: ضريبة التوريد غير قابلة للاسترداد ومضافة للتكلفة. دفاتر الضريبة القابلة للاسترداد تحتاج معالجة مستقلة معتمدة؛ لا تتغير الفواتير القديمة تلقائيًا." TextWrapping="Wrap" Margin="4,0,4,8"/>
   <TextBlock x:Name="Status" TextWrapping="Wrap" FontWeight="Bold" Margin="4,0,4,10"/>
   <TextBlock Text="الأرصدة والتقارير تخص الدفتر منذ التفعيل الافتتاحي فقط. لا تمثل الفواتير القديمة دليلًا على التحصيل أو المديونية. المبالغ بالجنيه." TextWrapping="Wrap" Margin="4,0,4,10"/>
   <Button x:Name="InventoryReviewButton" Content="مراجعة فرق تقييم المخزون السابق واعتماد تسويته" Click="InventoryReviewClick" Visibility="Collapsed"/>
   <WrapPanel><TextBlock Text="من" VerticalAlignment="Center"/><DatePicker x:Name="FromDate" Width="150"/><TextBlock Text="إلى" VerticalAlignment="Center"/><DatePicker x:Name="ToDate" Width="150"/><Button Content="تحديث الحسابات والتقرير" Click="RefreshClick"/></WrapPanel>
  </StackPanel>
  <TabControl>
   <TabItem Header="الأرصدة وكشف الحساب"><DockPanel Margin="8">
    <Button DockPanel.Dock="Bottom" Content="كشف الطرف المحدد عن الفترة (مع الحركات السابقة كرصد افتتاحي)" Click="StatementClick"/>
    <DataGrid x:Name="Balances" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"><DataGrid.Columns>
     <DataGridTextColumn Header="الطرف" Binding="{Binding name}" Width="2*"/>
     <DataGridTextColumn Header="مديونية عميل" Binding="{Binding receivable_cents, Converter={StaticResource Money}}" Width="*"/>
     <DataGridTextColumn Header="مستحق مورد" Binding="{Binding payable_cents, Converter={StaticResource Money}}" Width="*"/>
     <DataGridTextColumn Header="مقدم عميل" Binding="{Binding customer_advance_cents, Converter={StaticResource Money}}" Width="*"/>
     <DataGridTextColumn Header="مقدم لمورد" Binding="{Binding supplier_advance_cents, Converter={StaticResource Money}}" Width="*"/>
     <DataGridTextColumn Header="دائن للعميل من مرتجع" Binding="{Binding customer_credit_cents, Converter={StaticResource Money}}" Width="*"/>
     <DataGridTextColumn Header="رصيد لنا لدى المورد" Binding="{Binding supplier_credit_cents, Converter={StaticResource Money}}" Width="*"/>
    </DataGrid.Columns></DataGrid>
   </DockPanel></TabItem>
   <TabItem Header="تحصيل / سداد / مصروف"><ScrollViewer><StackPanel Margin="15">
    <TextBlock Text="نوع الحركة"/><ComboBox x:Name="OperationType" SelectedIndex="0"><ComboBoxItem Tag="CUSTOMER_PAYMENT" Content="تحصيل من عميل"/><ComboBoxItem Tag="SUPPLIER_PAYMENT" Content="سداد لمورد"/><ComboBoxItem Tag="EXPENSE" Content="مصروف نقدي"/><ComboBoxItem Tag="CAPITAL" Content="تمويل الخزنة من رأس المال (ليس إيرادًا)"/><ComboBoxItem Tag="CUSTOMER_CREDIT" Content="تطبيق رصيد دائن لعميل على مديونيته"/><ComboBoxItem Tag="SUPPLIER_CREDIT" Content="تطبيق رصيد لنا لدى المورد على مستحقاته"/><ComboBoxItem Tag="CUSTOMER_ADVANCE" Content="تسوية مقدم عميل مع مديونيته (دون نقد)"/><ComboBoxItem Tag="SUPPLIER_ADVANCE" Content="تسوية مقدم مورد مع المستحق له (دون نقد)"/></ComboBox>
    <TextBlock Text="الطرف للتحصيل أو السداد"/><ComboBox x:Name="OperationParty" DisplayMemberPath="name" SelectedValuePath="party_id"/>
    <TextBlock Text="تصنيف المصروف"/><ComboBox x:Name="ExpenseAccount" DisplayMemberPath="name" SelectedValuePath="code"/>
    <TextBlock Text="المبلغ بالجنيه"/><TextBox x:Name="Amount" Text="0" FlowDirection="LeftToRight"/>
    <TextBlock Text="مرجع فريد (احتفظ به عند إعادة المحاولة)"/><TextBox x:Name="Reference"/>
    <TextBlock Text="بيان الحركة"/><TextBox x:Name="Memo" MaxLength="500"/>
    <TextBlock Text="التاريخ"/><DatePicker x:Name="OperationDate"/>
    <TextBlock Text="أي زيادة عن المديونية ستظهر رصيدًا مقدمًا مستقلًا. لا تُخصم الأرصدة المقدمة تلقائيًا من فواتير لاحقة." TextWrapping="Wrap" Margin="4,10"/>
    <Button Content="مراجعة ثم اعتماد الحركة" Click="PostClick"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="توزيع السداد على الفواتير"><DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="التوزيع يربط حركة مسجلة بفاتورتها ولا يغيّر الخزنة أو المديونية أو الأرباح. اختر فاتورة الطرف نفسه. التحصيل غير الموزع يظل ظاهرًا منفصلًا، ولا نخمن الفاتورة المقصودة." TextWrapping="Wrap" Margin="4,6"/>
     <TextBlock Text="حركة السداد غير الموزعة بالكامل"/><ComboBox x:Name="AllocationPayment" DisplayMemberPath="label" SelectedValuePath="id"/>
     <TextBlock Text="الفاتورة المالية"/><ComboBox x:Name="AllocationInvoice" DisplayMemberPath="label" SelectedValuePath="document_id"/>
     <TextBlock Text="مبلغ التوزيع بالجنيه"/><TextBox x:Name="AllocationAmount" Text="0"/>
     <TextBlock Text="مرجع توزيع فريد"/><TextBox x:Name="AllocationReference"/>
     <Button Content="اعتماد ربط السداد بالفاتورة" Click="AllocateClick"/>
    </StackPanel>
    <DataGrid x:Name="FinancialInvoiceGrid" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns>
     <DataGridTextColumn Header="الفاتورة" Binding="{Binding doc_code}" Width="*"/>
     <DataGridTextColumn Header="الطرف" Binding="{Binding party_name}" Width="2*"/>
     <DataGridTextColumn Header="الدين الأصلي" Binding="{Binding initial_debt_cents, Converter={StaticResource Money}}" Width="*"/>
     <DataGridTextColumn Header="سداد موزع" Binding="{Binding allocated_cents, Converter={StaticResource Money}}" Width="*"/>
     <DataGridTextColumn Header="متبقي قبل توزيع باقي السداد" Binding="{Binding unallocated_invoice_cents, Converter={StaticResource Money}}" Width="2*"/>
    </DataGrid.Columns></DataGrid>
   </DockPanel></TabItem>
   <TabItem Header="مرتجع بيع / شراء"><DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="اختر الفاتورة الأصلية، وأدخل الكميات بالوحدة الأساسية. رد النقد وتخفيض الدين محدودان بما ثبت للفاتورة؛ وزع سدادها أولًا عند الحاجة. لا نخمن بيانات الفواتير القديمة غير المرتبطة بالدفتر." TextWrapping="Wrap"/>
     <WrapPanel><ComboBox x:Name="ReturnInvoice" DisplayMemberPath="label" SelectedValuePath="document_id" Width="390"/><Button Content="تحميل سطور الأصل" Click="LoadReturnClick"/></WrapPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <WrapPanel><TextBlock Text="تخفيض المديونية بالجنيه" VerticalAlignment="Center"/><TextBox x:Name="ReturnDebt" Text="0" Width="120"/><TextBlock Text="رصيد دائن محتفظ به" VerticalAlignment="Center"/><TextBox x:Name="ReturnCredit" Text="0" Width="120"/><TextBlock Text="الباقي يُرد نقدًا" VerticalAlignment="Center" Margin="8"/></WrapPanel>
     <TextBlock Text="مستفيد الرصيد الدائن (مطلوب للفاتورة النقدية دون اسم؛ الفاتورة المسماة لا تغير طرفها)" TextWrapping="Wrap"/><ComboBox x:Name="ReturnCreditParty" DisplayMemberPath="name" SelectedValuePath="party_id"/>
     <TextBlock Text="بيان المرتجع"/><TextBox x:Name="ReturnMemo" MaxLength="500"/>
     <TextBlock Text="مرجع مرتجع فريد"/><TextBox x:Name="ReturnReference"/>
     <TextBlock x:Name="ReturnSummary" TextWrapping="Wrap" FontWeight="Bold" Margin="4,8"/>
     <WrapPanel><Button Content="معاينة أثر المرتجع" Click="PreviewReturnClick"/><Button Content="مراجعة ثم اعتماد المرتجع" Click="PostReturnClick"/><Button Content="عرض / طباعة آخر مرتجع" Click="PrintReturnClick"/></WrapPanel>
    </StackPanel>
    <DataGrid x:Name="ReturnLinesGrid" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns>
     <DataGridTextColumn Header="الصنف الأصلي" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
     <DataGridTextColumn Header="الوحدة الأساسية" Binding="{Binding Unit}" Width="*" IsReadOnly="True"/>
     <DataGridTextColumn Header="المتاح للإرجاع" Binding="{Binding AvailableText}" Width="*" IsReadOnly="True"/>
     <DataGridTextColumn Header="كمية المرتجع" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
    </DataGrid.Columns></DataGrid>
   </DockPanel></TabItem>
   <TabItem Header="سجل المرتجعات"><DockPanel Margin="8">
    <Button Content="عرض / طباعة المرتجع المحدد" DockPanel.Dock="Bottom" Click="PrintSelectedReturnClick"/>
    <DataGrid x:Name="ReturnHistory" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"><DataGrid.Columns>
     <DataGridTextColumn Header="المرتجع" Binding="{Binding code}" Width="*"/>
     <DataGridTextColumn Header="الأصل" Binding="{Binding original_code}" Width="*"/>
     <DataGridTextColumn Header="النوع" Binding="{Binding return_type}" Width="*"/>
     <DataGridTextColumn Header="التاريخ" Binding="{Binding return_date}" Width="*"/>
     <DataGridTextColumn Header="الطرف" Binding="{Binding party}" Width="2*"/>
     <DataGridTextColumn Header="القيمة" Binding="{Binding total_cents, Converter={StaticResource Money}}" Width="*"/>
     <DataGridTextColumn Header="نقد" Binding="{Binding cash_cents, Converter={StaticResource Money}}" Width="*"/>
     <DataGridTextColumn Header="تخفيض الدين" Binding="{Binding debt_cents, Converter={StaticResource Money}}" Width="*"/><DataGridTextColumn Header="رصيد دائن" Binding="{Binding credit_cents, Converter={StaticResource Money}}" Width="*"/>
    </DataGrid.Columns></DataGrid>
   </DockPanel></TabItem>
   <TabItem Header="الأطراف وتصنيفات المصروف"><StackPanel Margin="15">
    <TextBlock Text="اسم الطرف"/><TextBox x:Name="PartyName" MaxLength="200"/>
    <TextBlock Text="نوع الطرف"/><ComboBox x:Name="PartyType" SelectedIndex="0"><ComboBoxItem Tag="CUSTOMER" Content="عميل"/><ComboBoxItem Tag="SUPPLIER" Content="مورد"/><ComboBoxItem Tag="BOTH" Content="عميل ومورد"/></ComboBox>
    <TextBlock Text="الهاتف"/><TextBox x:Name="Phone" MaxLength="100"/><Button Content="إضافة الطرف" Click="CreatePartyClick"/>
    <TextBlock Text="تصنيف مصروف جديد" Margin="4,25,4,4"/><TextBox x:Name="CategoryName" MaxLength="120"/><Button Content="إضافة التصنيف" Click="CreateCategoryClick"/>
   </StackPanel></TabItem>
   <TabItem Header="الأرباح وميزان المراجعة"><DockPanel Margin="8">
    <TextBlock x:Name="Profit" DockPanel.Dock="Top" TextWrapping="Wrap" FontWeight="Bold" Margin="4,8"/>
    <DataGrid x:Name="Trial" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns>
     <DataGridTextColumn Header="الحساب" Binding="{Binding name}" Width="2*"/>
     <DataGridTextColumn Header="مدين" Binding="{Binding debit_cents, Converter={StaticResource Money}}" Width="*"/>
     <DataGridTextColumn Header="دائن" Binding="{Binding credit_cents, Converter={StaticResource Money}}" Width="*"/>
    </DataGrid.Columns></DataGrid>
   </DockPanel></TabItem>
   <TabItem Header="افتتاح وتفعيل الحسابات"><DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top"><TextBlock x:Name="OpeningInventoryHint" FontWeight="Bold" TextWrapping="Wrap" Margin="4,8"/><TextBlock Text="أدخل الأرصدة الفعلية المراجعة: الخزنة والمخزون وكل عميل ومورد والطرف المقابل الافتتاحي. يجب تساوي المدين والدائن. لا تُستنتج هذه الأرصدة من الفواتير القديمة. راجع القيد قبل التفعيل؛ القيد المعتمد لا يُعدل." TextWrapping="Wrap"/>
     <WrapPanel><Button Content="إضافة سطر" Click="AddOpeningLineClick"/><Button Content="مراجعة ثم اعتماد الافتتاح والتفعيل معًا" Click="OpeningClick"/></WrapPanel>
     <TextBlock Text="للبداية الصفرية الحقيقية: اترك المدين والدائن صفرًا في كل السطور. لن يُنشأ قيد بأموال وهمية." TextWrapping="Wrap"/>
    </StackPanel>
    <DataGrid x:Name="OpeningGrid" ItemsSource="{Binding OpeningLines}" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns>
     <DataGridTemplateColumn Header="الحساب" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Accounts, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="name" SelectedValuePath="code" SelectedValue="{Binding AccountCode, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="الطرف عند الحاجة" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Parties, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="name" SelectedValuePath="party_id" SelectedValue="{Binding PartyId, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="مدين (جنيه)" Binding="{Binding Debit, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
     <DataGridTextColumn Header="دائن (جنيه)" Binding="{Binding Credit, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
    </DataGrid.Columns></DataGrid>
   </DockPanel></TabItem>
  </TabControl>
 </DockPanel>
</Window>

<Window x:Class="OfflineStore.SerialScannerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعدادات قارئ الباركود Serial" Height="610" Width="560"
        MinHeight="530" MinWidth="490" ResizeMode="CanResize"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource BaseBrush}" Foreground="{DynamicResource TextBrush}">
  <Border Style="{StaticResource SurfaceCard}" Margin="18" Padding="17">
  <DockPanel Margin="4">
    <TextBlock DockPanel.Dock="Top" Text="إعدادات ماسح COM" Style="{StaticResource SectionHeading}" FontSize="23" Margin="0,0,0,8"/>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock x:Name="StatusText" Text="اختبار القراءة لا يضيف أي أصناف للفاتورة." TextWrapping="Wrap" Margin="0,0,0,10"/>
      <WrapPanel HorizontalAlignment="Left">
        <Button Content="اختبار المسح" Click="TestClick" Width="110" Margin="4"/>
        <Button Content="إيقاف الاختبار" Click="StopTestClick" Width="110" Margin="4"/>
        <Button Content="حفظ" Style="{StaticResource SuccessButton}" Click="SaveClick" Width="100" Margin="4"/>
        <Button Content="إغلاق" Style="{StaticResource OutlineButton}" Click="CloseClick" Width="95" Margin="4"/>
      </WrapPanel>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <CheckBox x:Name="EnabledBox" Content="تفعيل الماسح عند فتح برنامج المبيعات" Margin="0,7,0,15"/>
        <TextBlock Text="منفذ الاتصال (COM)"/>
        <DockPanel Margin="0,4,0,12">
          <Button Content="تحديث المنافذ" Click="RefreshClick" DockPanel.Dock="Left" Width="125" Margin="6,0,0,0"/>
          <ComboBox x:Name="PortCombo" IsEditable="True" FlowDirection="LeftToRight"/>
        </DockPanel>
        <TextBlock Text="سرعة الاتصال (Baud Rate)"/>
        <ComboBox x:Name="BaudCombo" Margin="0,4,0,12" Width="220" HorizontalAlignment="Right"/>
        <TextBlock Text="عدد بتات البيانات (Data Bits)"/>
        <ComboBox x:Name="BitsCombo" Margin="0,4,0,12" Width="220" HorizontalAlignment="Right"/>
        <TextBlock Text="التكافؤ (Parity)"/>
        <ComboBox x:Name="ParityCombo" Margin="0,4,0,12" Width="220" HorizontalAlignment="Right"/>
        <TextBlock Text="بتات التوقف (Stop Bits)"/>
        <ComboBox x:Name="StopCombo" Margin="0,4,0,12" Width="220" HorizontalAlignment="Right"/>
        <TextBlock Text="التحكم في التدفق (Handshake)"/>
        <ComboBox x:Name="HandshakeCombo" Margin="0,4,0,12" Width="260" HorizontalAlignment="Right"/>
        <TextBlock Text="ضروري: اضبط جهاز الماسح لإرسال CR أو LF أو CRLF بعد كل باركود. لا تفترض أن 9600/8/N/1 هي إعداداته الحقيقية؛ طابق مواصفات الماسح." TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,10"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Border>
</Window>

<UserControl x:Class="OfflineStore.Supply.SupplyVoucherControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="13"
 Background="{DynamicResource BaseBrush}" Foreground="{DynamicResource TextBrush}">
 <UserControl.Resources>
  <Style x:Key="SmallLabel" TargetType="TextBlock">
   <Setter Property="Margin" Value="4,0,4,4"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
  </Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <Grid Margin="12">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="380"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <!-- Header: master document and commands -->
  <Border Grid.Row="0" Style="{StaticResource SurfaceCard}" Margin="0,0,0,10">
   <StackPanel>
    <StackPanel Margin="0,0,0,10">
     <StackPanel Margin="0,0,0,6">
      <TextBlock Text="سند توريد واستلام" Style="{StaticResource SectionHeading}" FontSize="22" TextWrapping="Wrap"/>
      <TextBlock x:Name="CodeText" Text="الكود يتولد تلقائيًا عند الحفظ"
          FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
     </StackPanel>
     <WrapPanel>
      <Button Content="جديد" Click="NewClick" MinWidth="68"/>
      <Button x:Name="SaveDraftButton" Content="حفظ مسودة" Click="SaveDraftClick" MinWidth="98"/>
      <Button x:Name="EditDraftButton" Content="تعديل" Click="EditDraftClick" MinWidth="69"/>
      <Button x:Name="ApproveButton" Content="اعتماد التوريد" Click="ApproveClick" MinWidth="119"
         Style="{StaticResource SuccessButton}"/>
      <Button x:Name="DeleteDraftButton" Content="حذف مسودة" Click="DeleteDraftClick" MinWidth="96"
         Style="{StaticResource DangerButton}"/>
      <Button Content="بحث" Click="SearchClick" MinWidth="69"/>
      <Button Content="طباعة" Click="PrintClick" MinWidth="77"/>
     </WrapPanel>
    </StackPanel>
    <WrapPanel>
     <StackPanel Margin="0,0,0,8">
      <TextBlock Text="تاريخ التوريد" Style="{StaticResource SmallLabel}"/>
      <DatePicker x:Name="VoucherDateBox" SelectedDateChanged="HeaderChanged" Width="143" Height="34"/>
     </StackPanel>
     <StackPanel Margin="0,0,10,8">
      <TextBlock Text="المورد *" Style="{StaticResource SmallLabel}"/>
      <DockPanel Width="255">
       <Button x:Name="NewSupplierButton" DockPanel.Dock="Left" Content="+ مورد" Click="AddSupplierClick" Width="69"
         MinWidth="0" ToolTip="إضافة مورد جديد دون مغادرة سند التوريد"/>
       <ComboBox x:Name="SupplierBox" SelectionChanged="HeaderChanged"
         DisplayMemberPath="Name" SelectedValuePath="Id" Height="34"
         IsTextSearchEnabled="True"/>
      </DockPanel>
     </StackPanel>
     <StackPanel Margin="0,0,10,8">
      <TextBlock Text="رقم فاتورة المورد" Style="{StaticResource SmallLabel}"/>
      <TextBox x:Name="SupplierInvoiceNoBox" Width="142" MaxLength="90"
               TextChanged="HeaderTextChanged" Height="34"/>
     </StackPanel>
     <StackPanel Margin="0,0,10,8">
      <TextBlock Text="تاريخ فاتورة المورد" Style="{StaticResource SmallLabel}"/>
      <DatePicker x:Name="SupplierInvoiceDateBox" Width="142" Height="34"
                  SelectedDateChanged="HeaderChanged"/>
     </StackPanel>
     <StackPanel Margin="0,0,10,8">
      <TextBlock Text="طريقة الدفع" Style="{StaticResource SmallLabel}"/>
      <ComboBox x:Name="PaymentTypeBox" Width="105" Height="34" SelectionChanged="HeaderChanged">
       <ComboBoxItem Content="نقدي" Tag="CASH" IsSelected="True"/>
       <ComboBoxItem Content="آجل" Tag="CREDIT"/>
      </ComboBox>
     </StackPanel>
     <StackPanel Margin="0,0,10,8">
      <TextBlock Text="الضريبة % (ضمن التكلفة)" Style="{StaticResource SmallLabel}" ToolTip="السياسة الحالية للضريبة غير القابلة للاسترداد؛ لا تدعم فصل ضريبة المدخلات القابلة للاسترداد."/>
      <TextBox x:Name="TaxRateBox" Width="92" Height="34" Text="0"
               TextChanged="HeaderTextChanged"/>
     </StackPanel>
     <StackPanel Margin="0,0,10,8">
      <TextBlock Text="خصم السند (جنيه)" Style="{StaticResource SmallLabel}"/>
      <TextBox x:Name="HeaderDiscountBox" Width="132" Height="34" Text="0"
               TextChanged="HeaderTextChanged"/>
     </StackPanel>
    </WrapPanel>
    <TextBox x:Name="NotesBox" MaxLength="2000" Height="36" Margin="0,2,0,0"
             TextChanged="HeaderTextChanged" ToolTip="ملاحظات السند (اختياري)"/>
   </StackPanel>
  </Border>

  <!-- Details: scanner input, product/unit selection, editable line form & grid -->
  <Border Grid.Row="1" Style="{StaticResource SurfaceCard}" Margin="0,0,0,10">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="الأصناف المستلمة" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,5"/>
     <WrapPanel Margin="0,0,0,5">
      <StackPanel Margin="0,0,0,5">
       <TextBlock Text="باركود / كود الصنف" Style="{StaticResource SmallLabel}"/>
       <TextBox x:Name="BarcodeBox" Width="182" Height="36" FontSize="15"
         KeyDown="BarcodeKeyDown" ToolTip="وجّه جهاز الباركود إلى هذه الخانة؛ Enter يختار الصنف"/>
      </StackPanel>
      <StackPanel Margin="0,0,8,5">
       <TextBlock Text="الصنف" Style="{StaticResource SmallLabel}"/>
       <ComboBox x:Name="ProductBox" Width="232" Height="36"
         DisplayMemberPath="DisplayName" IsTextSearchEnabled="True" IsEditable="True"
         SelectionChanged="ProductChanged"/>
      </StackPanel>
      <StackPanel Margin="0,0,8,5">
       <TextBlock Text="الوحدة" Style="{StaticResource SmallLabel}"/>
       <ComboBox x:Name="UnitBox" Width="136" Height="36"
         DisplayMemberPath="DisplayName" SelectionChanged="UnitChanged"/>
      </StackPanel>
      <StackPanel Margin="0,0,8,5">
       <TextBlock Text="الكمية" Style="{StaticResource SmallLabel}"/>
       <TextBox x:Name="QtyBox" Width="90" Height="36" Text="1" TextChanged="LineTextChanged"/>
      </StackPanel>
      <StackPanel Margin="0,0,8,5">
       <TextBlock Text="سعر الشراء" Style="{StaticResource SmallLabel}"/>
       <TextBox x:Name="CostBox" Width="105" Height="36" Text="0" TextChanged="LineTextChanged"/>
      </StackPanel>
      <StackPanel Margin="0,0,8,5">
       <TextBlock Text="الخصم" Style="{StaticResource SmallLabel}"/>
       <TextBox x:Name="DiscountBox" Width="80" Height="36" Text="0" TextChanged="LineTextChanged"/>
      </StackPanel>
      <StackPanel Margin="0,0,8,5">
       <TextBlock Text="نوع الخصم" Style="{StaticResource SmallLabel}"/>
       <ComboBox x:Name="LineDiscountTypeBox" Width="88" Height="36" SelectionChanged="LineSelectionChanged">
        <ComboBoxItem Tag="AMOUNT" Content="جنيه" IsSelected="True"/>
        <ComboBoxItem Tag="PERCENT" Content="%"/>
       </ComboBox>
      </StackPanel>
      <Button x:Name="AddLineButton" Content="إضافة سطر" Click="AddLineClick" Height="36"
        MinWidth="94" VerticalAlignment="Bottom" Margin="8,0,0,5"/>
     </WrapPanel>
     <TextBlock x:Name="LineHelpText" Text="اختر الصنف أو امسح الباركود، ثم أدخل الكمية والتكلفة. المسح لا يعتمد السند تلقائيًا."
       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,9"/>
    </StackPanel>
    <DataGrid x:Name="DetailsGrid" AutoGenerateColumns="False" IsReadOnly="True"
      SelectionMode="Single" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="35"
      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
      BorderThickness="0" FlowDirection="RightToLeft">
      <DataGrid.Columns>
       <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="36"/>
       <DataGridTextColumn Header="الصنف" Binding="{Binding Name}" Width="190"/>
       <DataGridTextColumn Header="الوحدة" Binding="{Binding Unit}" Width="70"/>
       <DataGridTextColumn Header="الكمية" Binding="{Binding Qty}" Width="75"/>
       <DataGridTextColumn Header="تكلفة الوحدة" Binding="{Binding Cost}" Width="105"/>
       <DataGridTextColumn Header="الخصم" Binding="{Binding Discount}" Width="92"/>
       <DataGridTextColumn Header="الصافي" Binding="{Binding Total}" Width="112"/>
       <DataGridTemplateColumn Header="العمليات" Width="142">
        <DataGridTemplateColumn.CellTemplate>
         <DataTemplate>
          <StackPanel Orientation="Horizontal">
           <Button Content="تعديل" Padding="5,3" Margin="1" Tag="{Binding}" Click="EditLineClick" MinWidth="58"/>
           <Button Content="حذف" Padding="5,3" Margin="1" Tag="{Binding}" Click="RemoveLineClick" MinWidth="58"/>
          </StackPanel>
         </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
   </DockPanel>
  </Border>

  <!-- Totals: derived values never directly editable -->
  <Border Grid.Row="2" Style="{StaticResource SurfaceCard}" Background="{DynamicResource SurfaceAltBrush}" Margin="0">
   <StackPanel>
    <WrapPanel>
     <StackPanel Width="150" Margin="0,0,7,4">
      <TextBlock Text="قبل الخصم" Style="{StaticResource SmallLabel}"/>
      <TextBlock x:Name="SubTotalText" FontSize="17" FontWeight="SemiBold" Text="0.00"/>
     </StackPanel>
     <StackPanel Width="150" Margin="0,0,7,4">
      <TextBlock Text="إجمالي الخصم" Style="{StaticResource SmallLabel}"/>
      <TextBlock x:Name="DiscountTotalText" FontSize="17" Text="0.00"/>
     </StackPanel>
     <StackPanel Width="150" Margin="0,0,7,4">
      <TextBlock Text="قيمة الضريبة" Style="{StaticResource SmallLabel}"/>
      <TextBlock x:Name="TaxAmountText" FontSize="17" Text="0.00"/>
     </StackPanel>
     <StackPanel Width="170" Margin="0,0,7,4">
      <TextBlock Text="صافي التوريد" Style="{StaticResource SmallLabel}"/>
      <TextBlock x:Name="GrandTotalText" FontSize="22" FontWeight="Bold" Text="0.00"/>
     </StackPanel>
     <StackPanel Width="130" Margin="0,0,7,4">
      <TextBlock Text="المدفوع (جنيه)" Style="{StaticResource SmallLabel}"/>
      <TextBox x:Name="PaidBox" Width="116" Height="32" Text="0"
        TextChanged="HeaderTextChanged"/>
     </StackPanel>
     <StackPanel Width="130" Margin="0,0,7,4">
      <TextBlock Text="المتبقي" Style="{StaticResource SmallLabel}"/>
      <TextBlock x:Name="RemainingText" FontSize="18" FontWeight="SemiBold" Text="0.00"/>
     </StackPanel>
    </WrapPanel>
    <TextBlock x:Name="WordsText" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,2"/>
    <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
      Foreground="{DynamicResource SecondaryTextBrush}" Text="سند جديد: الحفظ كمسودة لا يزيد المخزون؛ الاعتماد هو عملية التوريد الفعلية."/>
   </StackPanel>
  </Border>
 </Grid>
 </ScrollViewer>
</UserControl>
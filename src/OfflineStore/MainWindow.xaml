<Window x:Class="OfflineStore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:brand="clr-namespace:OfflineStore.Appearance"
        xmlns:supply="clr-namespace:OfflineStore.Supply"
        Title="OfflineStore | نظام إدارة المبيعات والمخزون" Height="860" Width="1480"
        MinWidth="960" MinHeight="680" FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource BaseBrush}" Foreground="{DynamicResource TextBrush}">
  <Window.Style>
    <Style TargetType="Window"><Style.Triggers>
      <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Cursor" Value="Wait"/></DataTrigger>
    </Style.Triggers></Style>
  </Window.Style>
  <Grid Background="{DynamicResource BaseBrush}" IsEnabled="{Binding IsIdle}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition x:Name="BrandColumn" Width="0"/>
    </Grid.ColumnDefinitions>
    <!-- Actual, embedded Windows EXE icon; legacy brand panel preserved for compatibility while collapsed to 0 width -->
    <Border x:Name="BrandPanel" Grid.Column="1" Visibility="Collapsed" Width="0" Background="{DynamicResource BrandPanelBrush}"
            Padding="0" SnapsToDevicePixels="True">
      <Image Source="{x:Static brand:BrandAssets.StoreIcon}" Width="0" Height="0"/>
    </Border>
    <Border Grid.Column="0" Background="{DynamicResource BaseBrush}" Padding="4">
    <DockPanel Background="{DynamicResource BaseBrush}">
    <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBrush}"
            Padding="12,8" CornerRadius="12" Margin="5,3,5,4">
      <DockPanel LastChildFill="True">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
          <Button Style="{StaticResource OutlineButton}" Content="تبديل الموظف" Click="SwitchEmployeeClick" ToolTip="تسجيل الخروج من الحساب الحالي وإلغاء حفظه على هذا الجهاز" Background="{DynamicResource HeaderBrush}" Margin="4,0"/>
          <Button Content="تحديث (F5)" Command="{Binding RefreshCommand}" Background="{DynamicResource PrimaryBrush}" ToolTip="تحديث الأصناف والأرصدة والتنبيهات" Margin="4,0"/>
          <Button Content="نسخة خارجية" Command="{Binding BackupCommand}" ToolTip="نسخ مفحوص إلى قرص USB أو قرص محلي غير قرص Windows" IsEnabled="{Binding CanBackup}" Background="{DynamicResource PrimaryBrush}" Margin="4,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border CornerRadius="8" Background="{DynamicResource PrimaryBrush}" Width="36" Height="36" Margin="0,0,10,0" Padding="4">
            <Image Source="{x:Static brand:BrandAssets.StoreIcon}" Stretch="Uniform"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Foreground="{DynamicResource HeaderTextBrush}" FontSize="18" FontWeight="Bold" Text="OfflineStore"/>
              <TextBlock Foreground="{DynamicResource HeaderSubTextBrush}" FontSize="13" FontWeight="Normal" Text=" | إدارة المبيعات والمخزون" Margin="5,2,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
              <TextBlock Foreground="{DynamicResource HeaderSubTextBrush}" Text="{Binding CurrentEmployee}" FontWeight="SemiBold" FontSize="11"/>
              <TextBlock Text="  •  " Foreground="{DynamicResource HeaderSubTextBrush}" FontSize="11"/>
              <TextBlock x:Name="ClockText" Foreground="{DynamicResource HeaderSubTextBrush}" FontSize="11"/>
              <TextBlock Text="  •  " Foreground="{DynamicResource HeaderSubTextBrush}" FontSize="11"/>
              <TextBlock x:Name="ScannerStatusText" Foreground="{DynamicResource HeaderSubTextBrush}" Text="ماسح COM: غير مفعل" FontSize="11"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceAltBrush}"
            CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" Padding="12,7" Margin="5,2,5,4">
      <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="OFFLINE • البيانات محلية بالكامل • النسخ الخارجي من الإعدادات يحمي من فقدان قرص Windows" />
    </Border>
    <TabControl x:Name="MainTabs" Margin="4,2,4,4" Background="{DynamicResource BaseBrush}"
                TabStripPlacement="Top" BorderThickness="0">
      <!-- Backward-compatibility anchor: TabStripPlacement="Left" -->
      <TabControl.Resources>
        <Style TargetType="{x:Type TabPanel}">
          <Setter Property="Background" Value="{DynamicResource NavRailBrush}"/>
          <Setter Property="HorizontalAlignment" Value="Stretch"/>
          <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="{x:Type TabItem}">
          <Setter Property="Background" Value="{DynamicResource NavRailBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
          <Setter Property="FontSize" Value="13"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type TabItem}">
                <Border x:Name="NavSurface"
                        Background="{DynamicResource NavRailBrush}"
                        CornerRadius="8" Margin="3,2" Padding="12,7" MinHeight="36"
                        SnapsToDevicePixels="True">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="NavIcon" Text="{TemplateBinding Tag}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16" Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="NavTitle" Text="{TemplateBinding Header}"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="13" VerticalAlignment="Center" FontWeight="SemiBold"/>
                  </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource PrimaryGradientBrush}"/>
                    <Setter TargetName="NavTitle" Property="Foreground" Value="White"/>
                    <Setter TargetName="NavIcon" Property="Foreground" Value="White"/>
                  </Trigger>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="NavSurface" Property="Opacity" Value="0.45"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </TabControl.Resources>
      <TabItem Tag="&#xE80F;" x:Name="DashboardTab" Header="الرئيسية">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="15">
            <TextBlock Text="الرئيسية" Style="{StaticResource SectionHeading}" FontSize="27" Margin="6,4,6,4"/>
            <TextBlock Text="ملخص مباشر من بيانات المحل — من غير أرقام تجريبية أو مميزات غير متاحة"
                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="6,0,6,14"
                       TextWrapping="Wrap"/>
            <UniformGrid Columns="3" Margin="0,0,0,8">
              <Border Style="{StaticResource MetricCard}" Background="{DynamicResource BlueMetricBrush}">
                <StackPanel>
                  <TextBlock Text="الأصناف المسجلة" Foreground="#E4F3FF" FontWeight="SemiBold"
                             FontSize="13"/>
                  <TextBlock Text="{Binding ProductCount}" Foreground="White"
                             FontSize="34" FontWeight="Bold" Margin="0,6,0,3"/>
                  <TextBlock Text="صنف نشط" Foreground="#DAECFF" FontSize="11"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource MetricCard}" Background="{DynamicResource GreenMetricBrush}">
                <StackPanel>
                  <TextBlock Text="الموردون" Foreground="#E4FFF6"
                             FontWeight="SemiBold" FontSize="13"/>
                  <TextBlock Text="{Binding SupplierCount}" Foreground="White"
                             FontSize="34" FontWeight="Bold" Margin="0,6,0,3"/>
                  <TextBlock Text="حسب صلاحيات الحساب" Foreground="#DEFFF4" FontSize="11"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource MetricCard}" Background="{DynamicResource PurpleMetricBrush}">
                <StackPanel>
                  <TextBlock Text="تنبيهات المخزون" Foreground="#F1EBFF"
                             FontWeight="SemiBold" FontSize="13"/>
                  <TextBlock Text="{Binding LowStockCount}" Foreground="White"
                             FontSize="34" FontWeight="Bold" Margin="0,6,0,3"/>
                  <TextBlock Text="أصناف عند حد الطلب" Foreground="#EDE8FF" FontSize="11"/>
                </StackPanel>
              </Border>
            </UniformGrid>
            <Border Style="{StaticResource SurfaceCard}" Margin="5,5,5,11">
              <StackPanel>
                <TextBlock Text="عمليات سريعة" Style="{StaticResource SectionHeading}"/>
                <WrapPanel>
                  <Button Content="بيع جديد  (F2)" Click="GoSalesClick" MinWidth="144" Height="48"
                          IsEnabled="{Binding CanSale}"/>
                  <Button Content="إدارة الأصناف" Click="GoProductsClick" MinWidth="144" Height="48"
                          Style="{StaticResource OutlineButton}"/>
                  <Button Content="فاتورة شراء" Click="GoPurchasesClick" MinWidth="144" Height="48"
                          IsEnabled="{Binding CanPurchase}" Style="{StaticResource OutlineButton}"/>
                  <Button Content="توريد واستلام" Click="GoGoodsReceiptClick" MinWidth="144" Height="48"
                          IsEnabled="{Binding CanPurchase}" Style="{StaticResource OutlineButton}"/>
                  <Button Content="ملحوظات الفريق" Click="GoNotesClick" MinWidth="144" Height="48"
                          Style="{StaticResource OutlineButton}"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SurfaceCard}" Margin="5,4,5,10">
              <StackPanel>
                <TextBlock Text="تنبيهات إعادة الطلب" Style="{StaticResource SectionHeading}"/>
                <TextBlock Text="{Binding LowStockBanner}" Foreground="{DynamicResource DangerBrush}"
                           FontWeight="SemiBold" Margin="5,0,5,9" TextWrapping="Wrap"/>
                <DataGrid ItemsSource="{Binding LowStock}" MaxHeight="240" MinHeight="92"
                          AutoGenerateColumns="False" IsReadOnly="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" Width="3*"/>
                    <DataGridTextColumn Header="المتبقي" Binding="{Binding StockText}" Width="1.5*"/>
                    <DataGridTextColumn Header="حد التنبيه" Binding="{Binding LimitText}" Width="1.5*"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="1.5*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SurfaceCard}" Margin="5,4,5,7"
                    Background="{DynamicResource SurfaceAltBrush}">
              <StackPanel>
                <TextBlock Text="إرشاد سريع" FontWeight="Bold" FontSize="16"
                           Foreground="{DynamicResource PrimaryBrush}" Margin="3,0,3,5"/>
                <TextBlock Text="الفواتير المعتمدة تغيّر رصيد المخزون. بعد تفعيل الحسابات بأرصدة افتتاحية مراجعة، تُربط الفواتير الجديدة بالتحصيل والمديونيات. الفواتير القديمة لا تُرحل تلقائيًا."
                           Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                           Margin="3"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Tag="&#xE719;" x:Name="ProductsTab" Header="الأصناف">
        <DockPanel Margin="9">
          <Border DockPanel.Dock="Top" Style="{StaticResource SurfaceCard}" IsEnabled="{Binding CanCatalog}"
                   Margin="2,0,2,10">
            <StackPanel>
              <DockPanel Margin="4,0,4,9">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                  <Button Content="صنف جديد" Command="{Binding ResetProductFormCommand}" Width="100"
                          Background="{DynamicResource HeaderBrush}" />
                  <Button Content="تعديل الصنف المحدد" Command="{Binding StartEditProductCommand}" Width="165"
                          ToolTip="حدد الصنف من الجدول ثم اضغط تعديل المحدد" />
                </StackPanel>
                <TextBlock Text="{Binding CatalogFormTitle}" FontWeight="SemiBold" FontSize="18"
                           VerticalAlignment="Center"/>
              </DockPanel>
              <WrapPanel VerticalAlignment="Center">
                <StackPanel><TextBlock Text="كود الصنف" Margin="5,0" /><TextBox Width="120" Text="{Binding NewSku, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                <StackPanel><TextBlock Text="اسم الصنف" Margin="5,0" />
                  <TextBox x:Name="ProductNameInput" Width="250" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" TextChanged="ProductNameTextChanged" PreviewKeyDown="ProductNameKeyDown" ToolTip="اكتب الاسم بحرية؛ Enter لاختيار الاقتراح إن ظهر" />
                  <Popup x:Name="ProductSuggestionPopup" PlacementTarget="{Binding ElementName=ProductNameInput}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Focusable="False">
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4" CornerRadius="6">
                      <ListBox x:Name="ProductSuggestionList" Width="285" MaxHeight="190" MouseDoubleClick="ProductSuggestionDoubleClick" MouseLeftButtonUp="ProductSuggestionMouseUp" FontSize="13"/>
                    </Border>
                  </Popup></StackPanel>
                <StackPanel><TextBlock Text="باركود القطعة (اختياري)" Margin="5,0" /><TextBox Width="150" Text="{Binding NewBarcode}" /></StackPanel>
                <StackPanel><TextBlock Text="الوحدة" Margin="5,0" /><TextBox Width="100" IsEnabled="{Binding IsUnitEditable}" Text="{Binding NewUnit, UpdateSourceTrigger=PropertyChanged}" ToolTip="اسم الوحدة الأساسية لا يتغير بعد إنشاء الصنف لحماية الفواتير القديمة" /></StackPanel>
                <StackPanel><TextBlock Text="سعر البيع" Margin="5,0" /><TextBox Width="105" Text="{Binding NewPrice, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                <StackPanel><TextBlock Text="سعر الشراء" Margin="5,0" /><TextBox Width="105" Text="{Binding NewCost, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                <StackPanel><TextBlock Text="حد النقص" Margin="5,0" /><TextBox Width="105" Text="{Binding NewReorder, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                <StackPanel>
                  <TextBlock Text="المورد (اختياري)" Margin="5,0"/>
                  <ComboBox Width="196" IsEditable="True" IsTextSearchEnabled="True"
                            ItemsSource="{Binding Suppliers}" DisplayMemberPath="Name"
                            TextSearch.TextPath="Name"
                            Text="{Binding CatalogSupplierText, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="اختر موردًا مسجلًا أو اكتب اسم مورد جديد؛ لا تُنشأ مشتريات تلقائيًا"/>
                </StackPanel>
                <Button Content="حفظ صنف جديد" Command="{Binding CreateProductCommand}"
                        IsEnabled="{Binding IsCreatingProduct}" VerticalAlignment="Bottom" />
                <Button Content="حفظ التعديل" Command="{Binding SaveProductChangesCommand}"
                        IsEnabled="{Binding IsEditingProduct}" VerticalAlignment="Bottom"
                        Background="{DynamicResource HeaderBrush}"/>
              </WrapPanel>
              <TextBlock Text="يمكنك ترك المورد فارغًا أو كتابة مورد جديد. ربط الصنف بالمورد لا يضيف كمية؛ المخزون يزيد فقط عند اعتماد شراء."
                         Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="5" />
            </StackPanel>
          </Border>
          <Expander DockPanel.Dock="Bottom" Header="العبوات ومستويات الأسعار وتنبيهات النواقص — إعدادات متقدمة" IsExpanded="False" Margin="3,6,3,6">
            <Border Background="{DynamicResource SurfaceBrush}" Padding="12" CornerRadius="12"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="وحدات العبوات للصنف المحدد — كل صنف يحدد عدد القطع داخل العلبة أو الدستة أو الكرتونة بنفسه" FontWeight="Bold" Margin="0,0,0,6"/>
              <WrapPanel IsEnabled="{Binding CanCatalog}">
                <StackPanel Margin="3"><TextBlock Text="الصنف"/><ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding CatalogProduct}" DisplayMemberPath="DisplayName" Width="230"/></StackPanel>
                <StackPanel Margin="3"><TextBlock Text="وحدة جديدة"/><TextBox Width="90" Text="{Binding PackageName}"/></StackPanel>
                <StackPanel Margin="3"><TextBlock Text="عدد القطع"/><TextBox Width="90" Text="{Binding PackageFactor}"/></StackPanel>
                <StackPanel Margin="3"><TextBlock Text="سعر بيع العبوة"/><TextBox Width="120" Text="{Binding PackagePrice}"/></StackPanel>
                <StackPanel Margin="3"><TextBlock Text="باركود العبوة"/><TextBox Width="145" Text="{Binding PackageBarcode}"/></StackPanel>
                <Button Content="إضافة وحدة" Command="{Binding AddPackageCommand}" VerticalAlignment="Bottom"/>
              </WrapPanel>
              <WrapPanel Margin="0,8,0,0" IsEnabled="{Binding CanCatalog}">
                <StackPanel Margin="3"><TextBlock Text="الوحدة المسجلة"/><ComboBox ItemsSource="{Binding CatalogUnits}" SelectedItem="{Binding CatalogUnit}" DisplayMemberPath="DisplayName" Width="235"/></StackPanel>
                <StackPanel Margin="3"><TextBlock Text="سعر القطاعي"/><TextBox Width="110" Text="{Binding UnitNewPrice}"/></StackPanel>
                <StackPanel Margin="3"><TextBlock Text="نص قطاعي"/><TextBox Width="110" Text="{Binding UnitSemiPrice}"/></StackPanel>
                <StackPanel Margin="3"><TextBlock Text="سعر الجملة"/><TextBox Width="110" Text="{Binding UnitWholesalePrice}"/></StackPanel>
                <Button Content="حفظ الأسعار الثلاثة" Command="{Binding SetUnitPriceCommand}" VerticalAlignment="Bottom"/>
              </WrapPanel>
              <WrapPanel Margin="0,8,0,0" IsEnabled="{Binding CanLowStock}">
                <TextBlock Text="حد النقص للصنف المحدد" FontWeight="Bold" Margin="4"/>
                <StackPanel Margin="3"><TextBlock Text="حد النقص (أساسي)"/><TextBox Width="110" Text="{Binding ReorderEdit}"/></StackPanel>
                <Button Content="تحديث حد التنبيه" Command="{Binding UpdateReorderCommand}" VerticalAlignment="Bottom"/>
              </WrapPanel>
            </StackPanel>
            </Border>
          </Expander>
          <DataGrid x:Name="CatalogProductsGrid" MinHeight="180" RowHeight="36" FlowDirection="RightToLeft" MouseDoubleClick="ProductTableDoubleClick"
                    ToolTip="انقر مرتين على الصنف لتحميل بياناته للتعديل" ItemsSource="{Binding Products}" SelectedItem="{Binding CatalogProduct}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="الكود" Binding="{Binding Sku}" Width="90" />
              <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="225" />
              <DataGridTextColumn Header="الوحدة" Binding="{Binding Unit}" Width="70" />
              <DataGridTextColumn Header="سعر البيع" Binding="{Binding SalePriceText}" Width="90" />
              <DataGridTextColumn Header="الرصيد" Binding="{Binding StockText}" Width="105" />
              <DataGridTextColumn Header="المورد" Binding="{Binding PreferredSupplier}" Width="150" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Tag="&#xE77B;" Header="الموردون" IsEnabled="{Binding CanPurchase}">
        <DockPanel Margin="9">
          <Border DockPanel.Dock="Top" Style="{StaticResource SurfaceCard}" Margin="2,0,2,10">
            <StackPanel>
              <TextBlock Text="إضافة مورد" FontSize="19" FontWeight="Bold" Margin="4" />
              <WrapPanel>
                <StackPanel><TextBlock Text="اسم المورد" Margin="5,0" /><TextBox Width="270" Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                <StackPanel><TextBlock Text="رقم الهاتف" Margin="5,0" /><TextBox Width="220" Text="{Binding SupplierPhone, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                <Button Content="حفظ المورد" Command="{Binding CreateSupplierCommand}" VerticalAlignment="Bottom" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <DataGrid ItemsSource="{Binding Suppliers}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="المورد" Binding="{Binding Name}" Width="*" />
              <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="230" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Tag="&#xE8CC;" x:Name="PurchasesTab" Header="المشتريات" IsEnabled="{Binding CanPurchase}">
        <DockPanel Margin="9">
            <Border DockPanel.Dock="Bottom" Style="{StaticResource SurfaceCard}"
                   Background="{DynamicResource SurfaceAltBrush}" Margin="2,5,2,3" Padding="9">
             <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="مراجعة ثم اعتماد الشراء" Command="{Binding PostPurchaseCommand}" FontWeight="Bold" />
            <Button Content="تعديل السطر المحدد" Command="{Binding EditPurchaseLineCommand}" />
             <Button Content="حذف السطر المحدد" Command="{Binding RemovePurchaseLineCommand}" Background="{DynamicResource PrimaryBrush}" />
            <TextBlock Text="الإجمالي: " FontWeight="Bold" Margin="30,0,5,0" FontSize="20" />
            <TextBlock Text="{Binding PurchaseTotal}" FontWeight="Bold" FontSize="20" />
          </WrapPanel>
           </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <Border Style="{StaticResource SurfaceCard}"
                   Background="{DynamicResource SurfaceAltBrush}" Margin="2,2,2,9">
             <StackPanel>
            <TextBlock Text="فاتورة شراء — اختر المورد والصنف ووحدة العبوة، ثم راجع السطور والإجمالي قبل الاعتماد." FontWeight="Bold" FontSize="17" Margin="12,9" TextWrapping="Wrap" />
            <WrapPanel Margin="8">
              <StackPanel><TextBlock Text="المورد" /><ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="Name" Width="220" /></StackPanel>
              <StackPanel><TextBlock Text="الصنف" /><ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding PurchaseProduct}" DisplayMemberPath="DisplayName" Width="270" /></StackPanel>
              <StackPanel><TextBlock Text="الوحدة"/><ComboBox ItemsSource="{Binding PurchaseUnits}" SelectedItem="{Binding PurchaseUnit}" DisplayMemberPath="DisplayName" Width="185"/></StackPanel>
              <StackPanel><TextBlock Text="الكمية بالوحدة المختارة" /><TextBox Text="{Binding PurchaseQty, UpdateSourceTrigger=PropertyChanged}" Width="120" /></StackPanel>
              <StackPanel><TextBlock Text="سعر الشراء" /><TextBox Text="{Binding PurchasePrice, UpdateSourceTrigger=PropertyChanged}" Width="110" /></StackPanel>
              <Button Content="{Binding PurchaseLineActionText}" Command="{Binding AddPurchaseLineCommand}" VerticalAlignment="Bottom" />
               <Button Content="إلغاء التعديل" Command="{Binding CancelPurchaseLineEditCommand}" IsEnabled="{Binding IsEditingPurchaseLine}" VerticalAlignment="Bottom"/>
            </WrapPanel>
          </StackPanel>
           </Border>
                <Border Style="{StaticResource SurfaceCard}" Margin="2,4,2,2" Padding="10">
             <DataGrid ItemsSource="{Binding PurchaseLines}" MinHeight="205" MaxHeight="285" VerticalScrollBarVisibility="Auto" SelectedItem="{Binding SelectedPurchaseLine}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" Width="*" />
              <DataGridTextColumn Header="الكمية المختارة" Binding="{Binding EnteredQtyText}" Width="160" />
              <DataGridTextColumn Header="بالوحدة الأساسية" Binding="{Binding QtyText}" Width="145" />
              <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding PriceText}" Width="140" />
              <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalText}" Width="160" />
            </DataGrid.Columns>
          </DataGrid>
           </Border>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
      </TabItem>
      <TabItem Tag="&#xE7BF;" x:Name="SalesTab" Header="المبيعات (F2)" IsEnabled="{Binding CanSale}">
        <DockPanel Margin="9">
            <Border DockPanel.Dock="Bottom" Style="{StaticResource SurfaceCard}"
                   Background="{DynamicResource SurfaceAltBrush}" Margin="2,5,2,3" Padding="9">
             <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="مراجعة ثم اعتماد البيع" Command="{Binding PostSaleCommand}" FontWeight="Bold" ToolTip="يعرض مراجعة نهائية للإجمالي قبل خصم المخزون" />
            <Button Content="تعديل السطر المحدد" Command="{Binding EditSaleLineCommand}" />
             <Button Content="حذف السطر المحدد" Command="{Binding RemoveSaleLineCommand}" Background="{DynamicResource PrimaryBrush}" />
            <TextBlock Text="الإجمالي: " FontWeight="Bold" Margin="30,0,5,0" FontSize="20" />
            <TextBlock Text="{Binding SaleTotal}" FontWeight="Bold" FontSize="20" />
          </WrapPanel>
           </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <Border Style="{StaticResource SurfaceCard}"
                   Background="{DynamicResource SurfaceAltBrush}" Margin="2,2,2,9">
             <StackPanel>
            <TextBlock Text="بيع سريع — امسح الباركود أو اختر الصنف، ثم حدد الوحدة والسعر والكمية" FontWeight="Bold" FontSize="17" Margin="12,9" TextWrapping="Wrap" />
            <TextBlock Text="بعد تفعيل الحسابات: البيع نقدي بالكامل افتراضيًا. اختر العميل وفعل البيع الجزئي أو الآجل لتسجيل المتبقي عليه." Foreground="{DynamicResource DangerBrush}" Margin="12,0,12,7" TextWrapping="Wrap" />
            <WrapPanel Margin="8">
              <StackPanel><TextBlock Text="العميل (اختياري للبيع النقدي)"/><ComboBox Width="230" ItemsSource="{Binding Customers}" DisplayMemberPath="Name" SelectedItem="{Binding SaleCustomer}"/></StackPanel>
              <CheckBox Content="دفع جزئي / آجل (للمدير)" IsEnabled="{Binding CanUsers}" IsChecked="{Binding CreditSale}" VerticalAlignment="Center" Margin="10"/>
              <StackPanel IsEnabled="{Binding CreditSale}"><TextBlock Text="المدفوع الآن بالجنيه"/><TextBox Width="130" Text="{Binding SalePaid, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            </WrapPanel>
            <WrapPanel Margin="8">
              <StackPanel><TextBlock Text="بحث سريع بالباركود أو SKU"/><TextBox x:Name="SaleBarcodeInput" Width="250" Text="{Binding SaleScan, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" ToolTip="امسح الباركود أو اكتبه واضغط Enter" KeyDown="SaleBarcodeKeyDown" /></StackPanel>
              <Button Content="عرض الصنف وسعره" Command="{Binding ScanSaleCommand}" VerticalAlignment="Bottom" />
              <TextBlock Text="{Binding LastBarcodeResult}" TextWrapping="Wrap" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0"/>
            </WrapPanel>
            <TextBlock Text="{Binding SaleStockHint}" Margin="12,2,12,5"
                       FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding SaleQuantityPreview}" TextWrapping="Wrap"
                       FontSize="13" Margin="12,2,12,9" FontWeight="SemiBold">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource PositiveBrush}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSaleQuantityInsufficient}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <WrapPanel Margin="8">
              <StackPanel><TextBlock Text="الصنف" /><ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SaleProduct}" DisplayMemberPath="DisplayName" Width="300" /></StackPanel>
              <StackPanel><TextBlock Text="الوحدة"/><ComboBox ItemsSource="{Binding SaleUnits}" SelectedItem="{Binding SaleUnit}" DisplayMemberPath="DisplayName" Width="185"/></StackPanel>
              <StackPanel><TextBlock Text="الكمية بالوحدة المختارة" /><TextBox Text="{Binding SaleQty, UpdateSourceTrigger=PropertyChanged}" Width="120" /></StackPanel>
              <StackPanel><TextBlock Text="مستوى سعر الفاتورة" />
                <ComboBox SelectedValue="{Binding SalePriceTier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="Tag" Width="120">
                  <ComboBoxItem Content="قطاعي" Tag="RETAIL" IsSelected="True"/>
                  <ComboBoxItem Content="نص قطاعي" Tag="SEMI"/>
                  <ComboBoxItem Content="جملة" Tag="WHOLESALE"/>
                </ComboBox>
              </StackPanel>
              <StackPanel><TextBlock Text="سعر البيع" /><TextBox Text="{Binding SalePrice, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsSalePriceReadOnly}" Width="130" /></StackPanel>
              <Button Content="{Binding SaleLineActionText}" Command="{Binding AddSaleLineCommand}" VerticalAlignment="Bottom" />
               <Button Content="إلغاء التعديل" Command="{Binding CancelSaleLineEditCommand}" IsEnabled="{Binding IsEditingSaleLine}" VerticalAlignment="Bottom"/>
            </WrapPanel>
          </StackPanel>
           </Border>
                <Border Style="{StaticResource SurfaceCard}" Margin="2,4,2,2" Padding="10">
             <DataGrid ItemsSource="{Binding SaleLines}" MinHeight="320" MaxHeight="520" VerticalScrollBarVisibility="Auto" SelectedItem="{Binding SelectedSaleLine}"
                    HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
              <DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" Width="3*" />
              <DataGridTextColumn Header="الكمية" Binding="{Binding EnteredQtyText}" Width="1.4*" />
              <DataGridTextColumn Header="أساسي" Binding="{Binding QtyText}" Width="1.1*" />
              <DataGridTextColumn Header="المستوى" Binding="{Binding PriceLevelText}" Width="1.2*" />
              <DataGridTextColumn Header="السعر" Binding="{Binding PriceText}" Width="1.1*" />
              <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalText}" Width="1.2*" />
            </DataGrid.Columns>
          </DataGrid>
           </Border>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
      </TabItem>
      <TabItem Tag="&#xE8A5;" Header="الفواتير" IsEnabled="{Binding CanReports}">
        <DockPanel Margin="9">
          <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceAltBrush}" Padding="12" CornerRadius="10">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="اختر فاتورة بيع، ثم اطبعها أو احفظ صورتها. فتحها على الهاتف يحتاج شبكة محلية." VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
              <Button Content="عرض / طباعة فاتورة البيع" Click="OpenSelectedReceiptClick" IsEnabled="{Binding CanReports}"/>
            </StackPanel>
          </Border>
        <DataGrid ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding Code}" Width="130" />
            <DataGridTextColumn Header="النوع" Binding="{Binding TypeText}" Width="90" />
            <DataGridTextColumn Header="الجهة" Binding="{Binding Party}" Width="*" />
            <DataGridTextColumn Header="الموظف" Binding="{Binding Employee}" Width="160" />
            <DataGridTextColumn Header="التاريخ UTC" Binding="{Binding CreatedUtc}" Width="270" />
            <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalText}" Width="170" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
      </TabItem>
      <TabItem Tag="&#xE70B;" x:Name="NotesTab" Header="ملحوظات">
        <Grid Margin="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Margin="0,0,0,0" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="14" Padding="12">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="دفتر ملحوظات الفريق" FontSize="19" FontWeight="SemiBold" Margin="3,0,3,8"/>
                <TextBlock Text="بحث محلي سريع في العناوين وأسماء الموظفين" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="3,0,3,6"/>
                <TextBox x:Name="NotesSearchBox" TextChanged="NotesSearchTextChanged" Margin="0,0,0,10" ToolTip="ابحث بعنوان الملحوظة أو اسم كاتبها" />
                <Button Content="+ إنشاء ملحوظة جديدة" Click="NewNoteClick" Margin="0,0,0,12"/>
              </StackPanel>
              <ListBox x:Name="NotesListBox" SelectionChanged="NotesSelectionChanged"
                       DisplayMemberPath="DisplayName" BorderThickness="0" Background="Transparent"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>
          </Border>
          <Border Grid.Column="1" Margin="10,0,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CornerRadius="14" Background="{DynamicResource SurfaceBrush}" Padding="18">
            <DockPanel LastChildFill="True">
              <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="عنوان الملحوظة" FontWeight="SemiBold" Margin="4,0,4,4"/>
                <TextBox x:Name="NoteTitleBox" TextChanged="NoteContentChanged" FontSize="16"
                         MaxLength="120" Height="42" Margin="0,0,0,9"/>
                <WrapPanel Margin="0,0,0,8">
                  <Button Content="عريض" Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=NotesEditor}" MinWidth="68" FontWeight="Bold" ToolTip="خط عريض"/>
                  <Button Content="مائل" Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=NotesEditor}" MinWidth="68" FontStyle="Italic"/>
                  <Button Content="تحته خط" Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=NotesEditor}" MinWidth="85"/>
                  <Button Content="• نقاط" Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=NotesEditor}" MinWidth="70"/>
                  <Button Content="حفظ الملحوظة (Ctrl+S)" Click="SaveNoteClick" MinWidth="120" Background="{DynamicResource PrimaryBrush}"/>
                </WrapPanel>
                <TextBlock x:Name="NoteStatusText" Text="أنشئ ملحوظة أو اختر واحدة من القائمة." Margin="3,0,3,10"
                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>
              <RichTextBox x:Name="NotesEditor" TextChanged="NoteContentChanged" AcceptsTab="True"
                           VerticalScrollBarVisibility="Auto" BorderBrush="{DynamicResource BorderBrush}"
                           BorderThickness="1" Padding="16" FontFamily="Segoe UI" FontSize="15"
                           FlowDirection="RightToLeft" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}">
                <FlowDocument FlowDirection="RightToLeft" PagePadding="0" />
              </RichTextBox>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Tag="&#xE713;" Header="الإعدادات">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="28" MaxWidth="740" HorizontalAlignment="Right">
            <TextBlock Text="إعدادات البرنامج" FontSize="26" FontWeight="Bold" Margin="0,0,0,16" />
            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="18" Margin="0,0,0,15">
              <StackPanel IsEnabled="{Binding CanAppearance}">
                <TextBlock Text="المظهر والألوان" FontSize="19" FontWeight="Bold" Margin="0,0,0,10" />
                <TextBlock Text="وضع العرض" />
                <ComboBox Width="240" HorizontalAlignment="Right" SelectedValuePath="Tag"
                          SelectedValue="{Binding SelectedTheme}">
                  <ComboBoxItem Content="فاتح" Tag="light" />
                  <ComboBoxItem Content="داكن" Tag="dark" />
                </ComboBox>
                <TextBlock Margin="0,10,0,0" Text="اللون الرئيسي" />
                <ComboBox Width="240" HorizontalAlignment="Right" SelectedValuePath="Tag"
                          SelectedValue="{Binding SelectedAccent}">
                  <ComboBoxItem Content="أزرق" Tag="blue" />
                  <ComboBoxItem Content="أخضر" Tag="green" />
                  <ComboBoxItem Content="بنفسجي" Tag="purple" />
                  <ComboBoxItem Content="رمادي" Tag="slate" />
                </ComboBox>
                <Button Content="حفظ المظهر" Command="{Binding SaveAppearanceCommand}"
                        HorizontalAlignment="Right" Width="180" Margin="0,12,0,0" />
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="18" Margin="0,0,0,15">
              <StackPanel>
                <TextBlock Text="قارئ الباركود Serial / COM" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBlock Text="يدعم ماسح RS-232 أو USB الذي يظهر كمنفذ COM. تُحفظ الإعدادات محليًا، ويُحدد الكاشير الصنف وسعر الوحدة عند المسح دون اعتماد فاتورة تلقائيًا." TextWrapping="Wrap" Margin="0,0,0,10"/>
                <Button Content="إعدادات الماسح واختبار القراءة" Click="ScannerSettingsClick" IsEnabled="{Binding CanUsers}" Width="260" HorizontalAlignment="Right"/>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="18" Margin="0,0,0,15">
              <StackPanel>
                <TextBlock Text="الحماية والدخول" FontSize="19" FontWeight="Bold" Margin="0,0,0,10" />
                <TextBlock Text="احمِ حساب المدير برقم سري قبل إضافة الموظفين. لكل موظف رقم سري من 6 إلى 12 رقمًا وصلاحيات محددة؛ حفظ دخول الموظف اختياري ومش متاح لحساب المدير."
                           TextWrapping="Wrap" Margin="0,0,0,12" />
                <Button Content="الحسابات والخزنة" Click="FinanceClick" IsEnabled="{Binding CanUsers}" Width="250" HorizontalAlignment="Right" />
                <Button Content="إدارة الموظفين وكلمات المرور" Click="SecurityClick" IsEnabled="{Binding CanUsers}" Width="250" HorizontalAlignment="Right" />
                <TextBlock Text="صلاحيات المستخدمين تُطبّق داخل منطق التطبيق. لا تُشفَّر قاعدة البيانات في هذه النسخة؛ أمّن حساب Windows والنسخة الاحتياطية."
                           TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,12,0,0" />
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="18">
              <StackPanel>
                <TextBlock Text="نسخ خارجية آمنة — بدون إنترنت" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,9"/>
                <TextBlock Text="مسار قاعدة البيانات المحلية" Margin="0,0,0,5"/>
                <TextBox Text="{Binding DatabasePath, Mode=OneWay}" IsReadOnly="True"
                         FlowDirection="LeftToRight" TextWrapping="NoWrap"/>
                <TextBlock Text="وسيط النسخ المعتمد" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <TextBlock x:Name="ExternalBackupPathText" Text="لم يتم اختيار قرص خارجي" TextWrapping="Wrap" FlowDirection="LeftToRight" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                <Button Content="اختيار مكان بيانات البرنامج" Click="MoveDataClick" IsEnabled="{Binding CanUsers}" HorizontalAlignment="Right" Margin="0,0,0,8"/>
                <Button Content="اختيار قرص USB / مجلد خارج Windows" Click="ConfigureBackupClick" IsEnabled="{Binding CanBackup}" MinHeight="40" HorizontalAlignment="Right" Margin="0,0,0,8"/>
                <WrapPanel Margin="0,12,0,7">
                  <Button Content="نسخة خارجية الآن" Command="{Binding BackupCommand}"
                          IsEnabled="{Binding CanBackup}" Width="170" MinHeight="39" Margin="0,0,7,0"/>
                  <Button Content="استرجاع نسخة احتياطية" Click="RestoreBackupClick"
                          IsEnabled="{Binding CanBackup}" Width="185" MinHeight="39"
                          Background="{DynamicResource HeaderBrush}"/>
                </WrapPanel>
                <TextBlock x:Name="BackupStatusText" Text="لم يتم فحص النسخ الخارجية بعد" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,10"/>
                <TextBlock Text="الاسترجاع يتحقق من الملف أولًا، ثم يُنفَّذ عند فتح البرنامج مرة أخرى. تُحفظ نسخة أمان من البيانات الحالية."
                           TextWrapping="Wrap" Margin="0,0,0,8"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Text="النسخ التلقائي يتم عند التشغيل ثم كل 20 دقيقة أثناء عمل البرنامج عند وجود وسيط معتمد. يجب إبقاء USB متصلًا؛ قسم D: على نفس القرص لا يحمي من عطل القرص بالكامل. احتفظ بنسخة ثانية منفصلة وآمنة."
                           TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Tag="&#xE81C;" Header="حركات المخزون" IsEnabled="{Binding CanReports}">
        <DataGrid ItemsSource="{Binding Movements}" Margin="12">
          <DataGrid.Columns>
            <DataGridTextColumn Header="الفاتورة" Binding="{Binding DocumentCode}" Width="150" />
            <DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" Width="*" />
            <DataGridTextColumn Header="التغير (+/-)" Binding="{Binding DeltaText}" Width="160" />
            <DataGridTextColumn Header="وقت الحركة UTC" Binding="{Binding CreatedUtc}" Width="270" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Tag="&#xE896;" x:Name="GoodsReceiptTab" Header="توريد واستلام" IsEnabled="{Binding CanPurchase}">
        <supply:SupplyVoucherControl x:Name="GoodsReceiptPanel"/>
      </TabItem>
    </TabControl>
    </DockPanel>
    </Border>
  </Grid>
</Window>

<Window x:Class="OfflineStore.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل الدخول | OfflineStore" Height="340" Width="480"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft" Background="{DynamicResource BaseBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="15">
  <Border Style="{StaticResource SurfaceCard}" Margin="20" Padding="24">
    <StackPanel>
      <TextBlock Text="فتح برنامج المبيعات" Style="{StaticResource SectionHeading}" FontSize="24" Margin="0,0,0,10" />
      <TextBlock Text="أدخل كلمة المرور المحلية للمتابعة" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,18" />
      <Grid Margin="0,0,0,6">
        <PasswordBox x:Name="PasswordInput" Padding="75,6,10,6" MinHeight="38" MaxLength="128"
                     KeyDown="OnPasswordKeyDown" PasswordChanged="OnPasswordChanged"
                     VerticalContentAlignment="Center" TabIndex="1"/>
        <TextBox x:Name="VisiblePasswordInput" Padding="75,6,10,6" MinHeight="38" MaxLength="128"
                 KeyDown="OnPasswordKeyDown" TextChanged="OnVisiblePasswordChanged"
                 Visibility="Collapsed" VerticalContentAlignment="Center" TabIndex="1"/>
        <Button x:Name="TogglePasswordButton" Click="OnTogglePasswordClick" Content="👁 إظهار"
                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0" Padding="8,4"
                Height="28" FontSize="11" Style="{StaticResource OutlineButton}" TabIndex="2"/>
      </Grid>
      <TextBlock x:Name="ErrorMessage" Foreground="#D94848" Margin="0,10" TextWrapping="Wrap" MinHeight="20"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
        <Button Content="دخول" Click="OnLoginClick" Width="110" IsDefault="True" TabIndex="3"/>
        <Button Content="إلغاء" Click="OnCancelClick" Style="{StaticResource OutlineButton}" Width="100" IsCancel="True" TabIndex="4"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>

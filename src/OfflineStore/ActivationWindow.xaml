<Window x:Class="OfflineStore.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OfflineStore - تفعيل البرنامج" Width="510" Height="280"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft" Background="#F1F6FF">
  <StackPanel Margin="24">
    <TextBlock Text="تفعيل OfflineStore" FontSize="23" FontWeight="Bold" Foreground="#0A244A" Margin="0,0,0,12"/>
    <TextBlock Text="أدخل السيريال نمبر لتفعيل البرنامج على هذا المستخدم في ويندوز." TextWrapping="Wrap" Margin="0,0,0,16"/>
    <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center">
      <TextBox x:Name="Part1" MaxLength="4" Width="88" CharacterCasing="Upper" TextAlignment="Center"/>
      <TextBlock Text="-" VerticalAlignment="Center"/>
      <TextBox x:Name="Part2" MaxLength="2" Width="65" CharacterCasing="Upper" TextAlignment="Center"/>
      <TextBlock Text="-" VerticalAlignment="Center"/>
      <TextBox x:Name="Part3" MaxLength="3" Width="75" CharacterCasing="Upper" TextAlignment="Center"/>
      <TextBlock Text="-" VerticalAlignment="Center"/>
      <TextBox x:Name="Part4" MaxLength="2" Width="65" CharacterCasing="Upper" TextAlignment="Center"/>
    </StackPanel>
    <TextBlock x:Name="ErrorText" Foreground="#B72F40" Margin="0,10,0,0" HorizontalAlignment="Center"/>
    <Button Content="تفعيل البرنامج" Click="OnActivate" Margin="0,12,0,0" Height="42"/>
  </StackPanel>
</Window>

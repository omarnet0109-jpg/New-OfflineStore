<Window x:Class="OfflineStore.UserManagementWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="إدارة الموظفين والصلاحيات | OfflineStore"
 Width="1110" Height="820" MinWidth="850" MinHeight="650"
 WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
 FontFamily="Segoe UI" FontSize="14"
 Background="{DynamicResource BaseBrush}" Foreground="{DynamicResource TextBrush}">
  <Grid Margin="14" Background="{DynamicResource BaseBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}"
            CornerRadius="14" Padding="20,16" Margin="4,4,4,10">
      <StackPanel>
        <TextBlock Text="إدارة الموظفين والصلاحيات" Foreground="White"
                   FontSize="24" FontWeight="Bold"/>
        <TextBlock Text="اختار الموظف لتعديل صلاحياته أو أنشئ حسابًا جديدًا؛ كل التغييرات تُطبق فورًا على العمليات الجديدة."
                   Foreground="{DynamicResource HeaderSubTextBrush}"
                   TextWrapping="Wrap" Margin="0,5,0,0"/>
      </StackPanel>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*"/>
        <ColumnDefinition Width="1.2*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource SurfaceCard}" Margin="4">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top" Margin="2,0,2,10">
            <TextBlock Text="الموظفون" Style="{StaticResource SectionHeading}"/>
            <TextBlock Text="اختار موظف من الجدول لعرض صلاحياته الحالية"
                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
          </StackPanel>
          <DataGrid x:Name="UsersGrid" IsReadOnly="True" AutoGenerateColumns="False"
                    CanUserAddRows="False" SelectionChanged="UsersSelectionChanged"
                    RowHeight="43" MinHeight="180">
            <DataGrid.Columns>
              <DataGridTextColumn Header="اسم الدخول" Binding="{Binding Username}" Width="1.4*"/>
              <DataGridTextColumn Header="اسم الموظف" Binding="{Binding DisplayName}" Width="2*"/>
              <DataGridTextColumn Header="الدور" Binding="{Binding Role}" Width="1.2*"/>
              <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="1*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource SurfaceCard}" Margin="4">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="إضافة أو تعديل موظف" Style="{StaticResource SectionHeading}"/>
            <WrapPanel>
              <StackPanel Margin="3" Width="178">
                <TextBlock Text="اسم المستخدم" Style="{StaticResource SmallFieldLabel}"/>
                <TextBox x:Name="UsernameInput"/>
              </StackPanel>
              <StackPanel Margin="3" Width="210">
                <TextBlock Text="اسم الموظف" Style="{StaticResource SmallFieldLabel}"/>
                <TextBox x:Name="NameInput"/>
              </StackPanel>
              <StackPanel Margin="3" Width="177">
                <TextBlock Text="الدور الأساسي" Style="{StaticResource SmallFieldLabel}"/>
                <ComboBox x:Name="RoleInput" SelectedIndex="2" SelectedValuePath="Tag"
                          SelectionChanged="RoleSelectionChanged">
                  <ComboBoxItem Content="مدير النظام" Tag="ADMIN"/>
                  <ComboBoxItem Content="مدير المبيعات" Tag="MANAGER"/>
                  <ComboBoxItem Content="كاشير" Tag="CASHIER"/>
                  <ComboBoxItem Content="مسؤول مخزن" Tag="STOCK"/>
                </ComboBox>
              </StackPanel>
              <StackPanel Margin="3" Width="213">
                <TextBlock Text="الرقم السري الجديد (6–12)" Style="{StaticResource SmallFieldLabel}"/>
                <Grid Height="46">
                  <PasswordBox x:Name="PasswordInput" MaxLength="12"
                               PasswordChanged="PasswordInputChanged"/>
                  <TextBox x:Name="VisiblePinInput" MaxLength="12"
                           Visibility="Collapsed" TextChanged="VisiblePinChanged"
                           TextAlignment="Left"/>
                </Grid>
                <CheckBox x:Name="ShowPinBox" Content="إظهار الرقم أثناء الكتابة"
                          Checked="ShowPinChanged" Unchecked="ShowPinChanged"/>
              </StackPanel>
            </WrapPanel>
            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="12"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Padding="12" Margin="0,12,0,6">
              <StackPanel>
                <TextBlock x:Name="PermissionHeaderText"
                           Text="صلاحيات الموظف الجديد — حدد المطلوب فقط"
                           Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"
                           FontSize="16" Margin="0,0,0,7" TextWrapping="Wrap"/>
                <WrapPanel x:Name="PermissionsPanel">
                  <CheckBox x:Name="AllowSale" Content="المبيعات والفواتير الجديدة"
                            Margin="6,7" MinWidth="185"/>
                  <CheckBox x:Name="AllowPurchase" Content="الشراء واستلام البضاعة"
                            Margin="6,7" MinWidth="185"/>
                  <CheckBox x:Name="AllowCatalog" Content="إضافة وتعديل الأصناف"
                            Margin="6,7" MinWidth="185"/>
                  <CheckBox x:Name="AllowReports" Content="الفواتير والتقارير"
                            Margin="6,7" MinWidth="185"/>
                  <CheckBox x:Name="AllowBackup" Content="النسخ والاسترجاع"
                            Margin="6,7" MinWidth="185"/>
                  <CheckBox x:Name="AllowLowStock" Content="تنبيهات نقص المخزون"
                            Margin="6,7" MinWidth="185"/>
                  <CheckBox x:Name="AllowOverridePrice" Content="تغيير سعر البيع"
                            Margin="6,7" MinWidth="185"/>
                  <CheckBox x:Name="AllowAppearance" Content="تعديل المظهر"
                            Margin="6,7" MinWidth="185"/>
                </WrapPanel>
                <TextBlock Text="إدارة الموظفين حصرية لمدير النظام، ولا يمكن منحها من هذه القائمة. الرقم السري القديم غير قابل للعرض."
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="12" TextWrapping="Wrap" Margin="2,8,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <Border Grid.Row="2" Style="{StaticResource SurfaceCard}"
            Padding="11" Margin="4,9,4,4">
      <StackPanel>
        <WrapPanel HorizontalAlignment="Center">
          <Button Content="موظف جديد" Click="NewUserClick" MinWidth="118"
                  Style="{StaticResource OutlineButton}"/>
          <Button Content="إضافة موظف" Click="CreateUserClick" MinWidth="125"
                  Style="{StaticResource SuccessButton}"/>
          <Button Content="حفظ صلاحيات المحدد" Click="SavePermissionsClick" MinWidth="170"/>
          <Button Content="تغيير رقم سر المحدد" Click="ResetClick" MinWidth="179"
                  Style="{StaticResource OutlineButton}"/>
          <Button Content="تفعيل / إيقاف المحدد" Click="ToggleClick" MinWidth="157"
                  Style="{StaticResource OutlineButton}"/>
        </WrapPanel>
        <TextBlock Text="الرقم الجديد من 6 إلى 12 رقمًا إنجليزيًا. التعديلات تُطبّق عند العملية التالية، ولا يمكن إيقاف آخر مدير نشط."
                   FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   HorizontalAlignment="Center" Margin="3,5,3,0"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>